{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novi-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],

  // This machine's Cloudflare account (kennethhuang0207@gmail.com).
  // Not another project's account.
  "account_id": "f7b9ca991f7981a64e78b60dce9d2b0a",

  // Secrets (wrangler secret put / .dev.vars), never in this file:
  //   ADMIN_PASSWORD         the admin site's password
  //   CONSOLE_ORIGIN_SECRET  what the Novi API sends to ingest
  "vars": {
    // Origin API the console calls when an admin disables a user.
    // Empty: D1 is still the ledger; login consults it. Postgres is
    // updated only when this is set to a reachable Novi API.
    "API_BASE_URL": ""
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novi-console",
      "database_id": "4bbacbf3-1510-4757-8615-9062cf613d87",
      "migrations_dir": "migrations"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

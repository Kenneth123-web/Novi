# ── Xcode / apps/mobile ───────────────────────────────────────────────────────
apps/mobile/build/
apps/mobile/DerivedData/
*.xcuserstate
xcuserdata/

# Generated by xcodegen — `cd apps/mobile && xcodegen generate`
apps/mobile/Novi.xcodeproj/
apps/mobile/Novi/Info.plist

# Per-person signing
apps/mobile/Configs/Local.xcconfig

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# ── Secrets and local state ───────────────────────────────────────────────────
# The Gemini gateway key lives in .env and must never be committed.
.env
.env.local
.run/

.DS_Store

# Seeded design-canvas payload — regenerate from the .dc.html sources with
# the design skill's seed helper rather than tracking 2MB of editor code.
design/canvas/*-canvas.html
design/canvas/novi-ui-system.html

# ── Cloudflare Worker ─────────────────────────────────────────────────────────
# Holds the real provider key locally; production uses `wrangler secret put`.
services/edge/.dev.vars
services/edge/node_modules/
services/edge/.wrangler/

services/console/.dev.vars
services/console/node_modules/
services/console/.wrangler/
services/console/secrets.local.json

services/turnstile-siteverify/node_modules/
services/turnstile-siteverify/.wrangler/
services/turnstile-siteverify/.dev.vars

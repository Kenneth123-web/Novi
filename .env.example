# Copy to .env and fill in. .env is gitignored — never commit real keys.

ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://novi:novi@localhost:5432/novi

# ── AI gateway ────────────────────────────────────────────────────────────────
# An OpenAI-compatible gateway in front of Gemini. The key is read here and
# never reaches the client: the app talks to /v1/ask, the API talks to Gemini.
AI_BASE_URL=https://1pkapi.com/v1
AI_API_KEY=
# "openai" = POST /v1/chat/completions with a bearer token.
# "anthropic" = POST /v1/messages with x-api-key.
# Which is right depends on what the gateway fronts, so check before changing.
AI_PROTOCOL=openai

# Must be a model the gateway actually lists at GET /v1/models — and that it
# can really serve. Listing is not serving: of this gateway's nine Grok
# entries only two answer. AI_MODEL_FALLBACKS is walked when one does not.
AI_MODEL=grok-4.6
AI_MODEL_FALLBACKS=grok-4.5,grok-4.6,grok-4.3
# Cheaper model for classification and search-term generation, where a large
# model buys nothing.
AI_MODEL_FAST=grok-4.5
AI_TIMEOUT_SECONDS=140

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required in every environment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Developer skip-login is opt-in and always requires a secret. Never enable it
# in production. Pass the same value to a Debug iOS build with
# `-devSkipSecret ...`.
DEV_SKIP_ENABLED=false
DEV_SKIP_SECRET=

# ── Console (Cloudflare Worker: accounts + API usage + admin site) ────────────
# After deploying services/console, point this at the Worker URL. Empty
# disables ingest so a fresh clone does not depend on Cloudflare being up.
CONSOLE_BASE_URL=
# Shared with the Worker (CONSOLE_ORIGIN_SECRET / wrangler secret). Generate:
#   openssl rand -base64 48
CONSOLE_ORIGIN_SECRET=

# ── Service ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
# Enable only when the API origin is reachable exclusively through a trusted
# reverse proxy that overwrites CF-Connecting-IP/X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ── Tutorial ingest ───────────────────────────────────────────────────────────
# YouTube Data API is optional: channel RSS and Invidious search run without it.
YOUTUBE_API_KEY=
# X (Twitter) recent search. Empty skips that source rather than inventing posts.
X_BEARER_TOKEN=
# JSON/JSONL dumps from https://github.com/NanmiCoder/MediaCrawler (XHS, Douyin,
# Zhihu, …). Live Bilibili search does not need this.
MEDIACRAWLER_DATA_DIR=
# Optional PEM of a local SSL-inspection root (Fortinet etc.). Reddit/X on
# this network present that issuer; Safari trusts it, Python does not.
SSL_EXTRA_CA=

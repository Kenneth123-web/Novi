# Copy to .env and fill in. .env is gitignored — never commit real keys.

ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://novi:novi@localhost:5432/novi

# ── AI gateway ────────────────────────────────────────────────────────────────
# An OpenAI-compatible gateway in front of Gemini. The key is read here and
# never reaches the client: the app talks to /v1/ask, the API talks to Gemini.
AI_BASE_URL=https://1pkapi.com/v1
AI_API_KEY=
# Must be a model the gateway actually lists at GET /v1/models — asking for
# one it does not serve fails per request, not at boot.
AI_MODEL=claude-sonnet-4-6
# Cheaper model for classification and search-term generation, where a large
# model buys nothing. Haiku would be the right choice; the gateway does not
# serve it today, so this is the same model until it does.
AI_MODEL_FAST=claude-sonnet-4-6
AI_TIMEOUT_SECONDS=60

# ── Auth ──────────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# ── Service ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

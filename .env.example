# Copy to .env and fill in. .env is gitignored — never commit real keys.

ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://novi:novi@localhost:5432/novi

# ── AI gateway ────────────────────────────────────────────────────────────────
# An OpenAI-compatible gateway in front of Gemini. The key is read here and
# never reaches the client: the app talks to /v1/ask, the API talks to Gemini.
AI_BASE_URL=https://1pkapi.com/v1
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
# Cheaper model for classification, concept extraction and search-term
# generation, where a large model buys nothing.
AI_MODEL_FAST=gemini-2.5-flash
AI_TIMEOUT_SECONDS=60

# ── Auth ──────────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# ── Service ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

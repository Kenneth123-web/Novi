// Committed. Everything person-specific lives in Local.xcconfig beside it.
//
// `#include?` is the OPTIONAL include: a fresh clone has no Local.xcconfig and
// must still configure and build for the simulator. A plain `#include` would
// fail the whole project instead.
NOV_API_BASE_URL =
NOV_API_USB_URL =
NOV_API_HOST_URL =
#include? "Local.xcconfig"
